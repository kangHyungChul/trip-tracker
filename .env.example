VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Legacy public anon JWT also supported via VITE_SUPABASE_ANON_KEY.
# VITE_ values are embedded in the browser bundle. Never use service_role or sb_secret_ keys (the build refuses them).

# Google Maps (Maps JavaScript API + Places API (New))
# 브라우저에 노출되는 키입니다. Google Cloud 콘솔에서 반드시
#   1) 애플리케이션 제한: HTTP 리퍼러 (예: http://localhost:5173/*, https://your-app.vercel.app/*)
#   2) API 제한: Maps JavaScript API, Places API (New)
# 을 설정하세요. 앱 ⚙ 설정에서 기기별 키를 넣으면 이 값보다 우선합니다.
VITE_GOOGLE_MAPS_API_KEY=
# 선택: 지도 ID (비우면 Google 의 DEMO_MAP_ID 사용)
VITE_GOOGLE_MAPS_MAP_ID=
