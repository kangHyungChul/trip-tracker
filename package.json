{
    "name": "trip-tracker",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "description": "TRIP TRACKER: multi-trip planner with Google Maps, restaurant list, drag reordering and Supabase sync (React + Vite)",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "seed": "py scripts/make-seed.py",
        "geocode": "node scripts/geocode-foods.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "db:login": "supabase login --output-format text",
        "db:link": "supabase link --output-format text",
        "db:push": "supabase db push --linked --output-format text"
    },
    "engines": {
        "node": ">=20.19"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@supabase/supabase-js": "^2.109.0",
        "@vis.gl/react-google-maps": "^1.10.2",
        "date-fns": "^4.4.0",
        "react": "^19.3.1",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^20.19.43",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "supabase": "^2.122.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    }
}
