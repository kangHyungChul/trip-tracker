{
    "name": "kagoshima-travel-journal",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "Editable Kagoshima trip with numbered map, navigation and Supabase sync (React + Vite)",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "seed": "py scripts/make-seed.py"
    },
    "engines": {
        "node": ">=20.19"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.109.0",
        "leaflet": "^1.9.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-leaflet": "^5.0.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^20.19.43",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    }
}
